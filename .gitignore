# 媒体与临时缓存数据 (不入版本库)
storage/uploads/*
storage/audio/*
storage/clips/*
storage/outputs/*
!storage/uploads/.gitkeep
!storage/audio/.gitkeep
!storage/clips/.gitkeep
!storage/outputs/.gitkeep

